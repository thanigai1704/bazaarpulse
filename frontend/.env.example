# ─────────────────────────────────────────────────────────────
# BazaarPulse Frontend — Environment Configuration
# Copy to `.env.local` and adjust for your deployment.
# ─────────────────────────────────────────────────────────────

# Base URL of the BazaarPulse FastAPI backend.
# - Local dev (with next.config proxy): NEXT_PUBLIC_API_URL=/api
# - Deployed: https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=/api

# WebSocket endpoint for live updates. In dev, Next rewrites do NOT proxy
# WebSockets, so point this directly at the backend:
#   local:     ws://localhost:8000/ws/live-updates
#   deployed:  wss://your-backend.up.railway.app/ws/live-updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-updates

# Used by next.config.js when you deploy the frontend separately.
BACKEND_URL=http://localhost:8000

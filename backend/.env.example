# ─────────────────────────────────────────────────────────────
# BazaarPulse Backend — Environment Configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# --- Database -------------------------------------------------
# Supabase Postgres URL (recommended for deployment):
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Local dev fallback (zero setup, file-based):
#   sqlite:///./bazaarpulse.db
DATABASE_URL=sqlite:///./bazaarpulse.db

# --- OpenAI (GPT-4o-mini) --------------------------------------
# Used for review sentiment classification, keyword extraction and
# AI market summaries. The platform degrades gracefully to a
# rule-based fallback if this is left empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data source ------------------------------------------------
# "live"   → (DEFAULT) scrape Flipkart + Amazon.in with Playwright. This is
#            the real-time path. Anti-bot blocks are common, so failed rounds
#            automatically fall back to the simulator for that cycle.
# "mixed"  → live first, then simulation fallback (same as live + fallback)
# "simulation" → simulator only (offline demo, no network needed)
SCRAPE_MODE=live

# --- Scheduler ---------------------------------------------------
# How often (minutes) the refresh cycle runs. Default 15 (spec: 15-20).
SIMULATION_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true

# --- CORS ---------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Re-seeding ----------------------------------------------------
# Set true once to wipe and re-seed the database with the generator dataset.
RESEED_ON_START=false

# --- Live scraping (only used when SCRAPE_MODE=live) ---------------
# Headless browser + polite delays. Keep robots.txt in mind.
SCRAPE_HEADLESS=true
SCRAPE_PAGE_DELAY_MS=4500
